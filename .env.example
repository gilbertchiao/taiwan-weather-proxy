# ===========================================================================
# taiwan-weather-proxy 環境變數設定範例
#
# 使用方式:複製本檔為 .env 後填入實際值。
#   cp .env.example .env
#
# 真實環境變數的優先權高於 .env 檔,容器化 / systemd 部署時可直接以
# 環境變數覆寫,不需提供 .env。
# ===========================================================================

# === 中央氣象署開放資料平臺 (CWA) ===
# 授權碼 (必要):至 https://opendata.cwa.gov.tw/ 註冊取得,格式形如 CWA-XXXXXXXX-...
CWA_API_KEY=

# datastore API 基底網址 (一般不需更動)
CWA_BASE_URL=https://opendata.cwa.gov.tw/api/v1/rest/datastore

# 即時觀測資料集代碼 (自動氣象站-氣象觀測資料)
DATASET_OBSERVATION=O-A0001-001

# 短效期預報資料集代碼 (鄉鎮天氣預報-新北市未來2天)
# 注意:此資料集為「新北市」專用;若要關注其他縣市,需更換對應的資料集代碼。
DATASET_FORECAST=F-D0047-069

# === 目標行政區 ===
# 預設關注的行政區;可用逗號分隔同時關注多個 (例如 三重區,板橋區,蘆洲區)。
# 第一個會作為 API 未帶 location 參數時的預設值。
TARGET_LOCATION=三重區

# /api/weather/forecast 預設回傳的未來時數 (每 3 小時一筆,12 小時約 4 筆)
FORECAST_HOURS=12

# === 排程 ===
# 是否啟用內建排程器 (true);設為 false 則改用外部 Cron / systemd timer 觸發 fetch。
ENABLE_SCHEDULER=true

# 即時觀測資料更新間隔 (秒),預設 600 (10 分鐘)
FETCH_INTERVAL_OBSERVATION=600

# 預報資料更新間隔 (秒),預設 3600 (1 小時)
FETCH_INTERVAL_FORECAST=3600

# === 重試 / 逾時 ===
# 上游 API 失敗時的最大重試次數
MAX_RETRIES=3
# 每次重試的間隔 (秒)
RETRY_DELAY_SECONDS=180
# 單次 HTTP 請求逾時 (秒)
HTTP_TIMEOUT_SECONDS=30

# === 資料過期判斷 ===
# 觀測資料超過此時間 (分鐘) 未更新即標記為過期 (is_stale=true)
# 預設 240 (4 小時):部分測站的觀測時間為整點更新,放寬門檻避免正常資料被誤標過期。
STALE_THRESHOLD_OBSERVATION_MINUTES=240

# === 儲存 ===
# SQLite 快取資料庫檔案路徑
DATABASE_PATH=data/weather.db

# === 日誌 ===
# 日誌等級:DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO
# 日誌目錄 (每日輪替、舊檔自動壓縮、保留 30 天)
LOG_DIR=logs

# === API 服務 ===
# 監聽位址
API_HOST=0.0.0.0
# 監聽埠號
PORT=8000
# 手動觸發更新端點 (POST /api/v1/refresh) 的權杖;留空則停用該端點。
REFRESH_TOKEN=
